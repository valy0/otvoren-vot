# Otvoren-Vot — Required Environment Variables
# Copy to .env and fill in values. Use deploy/generate-dev-keys.sh for local development.

# Database passwords (separate for layer isolation)
POSTGRES_PASSWORD_BB=
POSTGRES_PASSWORD_COLLECTION=

# API keys for inter-service authentication
INTERNAL_API_KEY=
SESSION_API_KEY=
BULLETIN_BOARD_API_KEY=
ACTIVE_SET_API_KEY=
CEREMONY_API_KEY=

# HMAC keys for voter identity hashing
EGN_HMAC_KEY=
HISTORY_HMAC_KEY=

# Verification service API key
VERIFICATION_API_KEY=

# Bulletin board signing key path (path inside container)
SIGNING_KEY_PATH=/keys/board-signing.pem

# TLS (optional — leave empty for HTTP in development)
# TLS_CERT_PATH=
# TLS_KEY_PATH=
# CA_CERT_PATH=
